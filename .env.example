# Copy this file to .env and fill in real values for local development.
# .env is git-ignored — never commit real secrets. The same variables (with
# real values) go into Vercel's Project Settings -> Environment Variables
# for production — see README "Deployment (Vercel)".

# --- Database: Neon (or any Postgres) ---
# Use Neon's *pooled* connection string (the one with "-pooler" in the
# hostname) with ?pgbouncer=true appended — required so Prisma works
# correctly through Neon's PgBouncer pooler. One Neon project works fine for
# both local dev and production; use a branch per environment if you want
# them fully separate.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/social_planner?sslmode=require&pgbouncer=true"

# --- Object storage: Cloudflare R2 (S3-compatible) ---
# See README "Set up Cloudflare R2" for how to get each of these.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="social-planner-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL media is reachable at over HTTPS (an R2 custom domain, or
# the rate-limited r2.dev URL for quick local testing) — required because
# the Instagram Graph API fetches media by URL at publish time.
S3_PUBLIC_BASE_URL="https://media.yourdomain.com"

# --- NextAuth (internal team login) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-generated-secret"
AUTH_URL="http://localhost:3000"

# --- Token encryption (for SocialAccount access/refresh tokens at rest) ---
# Generate with: openssl rand -hex 32  (must be exactly 64 hex chars / 32 bytes)
TOKEN_ENCRYPTION_KEY="replace-with-generated-32-byte-hex-key"

# --- Cron routes (src/app/api/cron/*), pinged by .github/workflows/cron.yml ---
# Generate with: openssl rand -base64 32. Also set as a GitHub Actions repo
# secret (CRON_SECRET) with the same value — see README.
CRON_SECRET="replace-with-generated-secret"

# --- Meta (Facebook + Instagram Graph API) ---
# Create an app at https://developers.facebook.com/apps — see README "Meta App Setup".
# Redirect URI to register in the Meta app (Facebook Login > Settings):
#   http://localhost:3000/api/connect/meta/callback (local)
#   https://your-project.vercel.app/api/connect/meta/callback (production)
META_APP_ID=""
META_APP_SECRET=""
# ID of a "Facebook Login for Business" Configuration (Meta app dashboard ->
# Facebook Login for Business -> Configurations) that grants pages_show_list,
# pages_read_engagement, pages_manage_posts. New Meta apps get this product
# instead of classic Facebook Login, which authorizes via config_id, not a
# scope list.
META_CONFIG_ID=""

# --- Instagram (API with Instagram Login) ---
# A *separate* product from Meta above — add "Instagram" (not Facebook
# Login) to the same Meta app, under App Dashboard -> Products. It has its
# own Instagram App ID/Secret and its own OAuth redirect URIs to register:
#   http://localhost:3000/api/connect/instagram/callback (local)
#   https://your-project.vercel.app/api/connect/instagram/callback (production)
# Connects an Instagram professional (Business/Creator) account directly —
# no Facebook Page needed. See README "Instagram App Setup".
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# --- LinkedIn (Marketing/Community Management API) ---
# Create an app at https://www.linkedin.com/developers/apps — see README "LinkedIn App Setup".
# Redirect URI to register in the LinkedIn app (Auth tab):
#   http://localhost:3000/api/connect/linkedin/callback (local)
#   https://your-project.vercel.app/api/connect/linkedin/callback (production)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Set to "true" only once LinkedIn has approved the Community Management API
# product for this app — requesting org scopes before that fails the whole
# OAuth request. Until then, only personal-profile posting is available.
LINKEDIN_ORGANIZATION_SCOPES_ENABLED="false"
