# Copy this file to .env and fill in real values for local development.
# .env is git-ignored — never commit real secrets.

# --- Database (matches docker-compose.yml postgres service) ---
DATABASE_URL="postgresql://social_planner:social_planner@localhost:5432/social_planner"

# --- Redis (BullMQ queue, matches docker-compose.yml redis service) ---
REDIS_URL="redis://localhost:6379"

# --- Object storage (S3-compatible). Local dev: MinIO (matches docker-compose.yml) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="social-planner-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# Public base URL from which uploaded media must be reachable over HTTPS.
# Instagram's Graph API fetches media by URL, so in production this must be a
# real public domain (e.g. your Cloudflare R2 public bucket URL or a CDN in front of it).
# For local dev this typically won't be reachable by Meta/LinkedIn — see README.
S3_PUBLIC_BASE_URL="http://localhost:9000/social-planner-media"

# --- NextAuth (internal team login) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-generated-secret"
AUTH_URL="http://localhost:3000"

# --- Token encryption (for SocialAccount access/refresh tokens at rest) ---
# Generate with: openssl rand -hex 32  (must be exactly 64 hex chars / 32 bytes)
TOKEN_ENCRYPTION_KEY="replace-with-generated-32-byte-hex-key"

# --- Meta (Facebook + Instagram Graph API) ---
# Create an app at https://developers.facebook.com/apps — see README "Meta App Setup".
# Redirect URI to register in the Meta app (Facebook Login > Settings):
#   http://localhost:3000/api/connect/meta/callback
META_APP_ID=""
META_APP_SECRET=""

# --- LinkedIn (Marketing/Community Management API) ---
# Create an app at https://www.linkedin.com/developers/apps — see README "LinkedIn App Setup".
# Redirect URI to register in the LinkedIn app (Auth tab):
#   http://localhost:3000/api/connect/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Set to "true" only once LinkedIn has approved the Community Management API
# product for this app — requesting org scopes before that fails the whole
# OAuth request. Until then, only personal-profile posting is available.
LINKEDIN_ORGANIZATION_SCOPES_ENABLED="false"

# --- Email notifications (optional) ---
# Notifies all workspace members by email when a client comments or
# approves a post via a share link. Leave unset to disable — notifications
# are then just skipped (logged), nothing else breaks.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Social Planner <no-reply@yourdomain.com>"
